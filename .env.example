# Copy to .env for local development. In production, set these in the Vercel
# project settings (Settings → Environment Variables), for Production + Preview.
#
# SECURITY: never prefix any of these with VITE_ — VITE_* variables are inlined
# into the public client bundle at build time.

# Neon Postgres — use the POOLED connection string from the Neon console
# (Project → Connection Details → "Pooled connection").
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Resend (https://resend.com) — API key from the dashboard. Sending to
# business@foxquart.com requires the foxquart.com domain to be verified in
# Resend (Domains → Add Domain → add the DNS records it shows).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form notifications are delivered.
CONTACT_TO_EMAIL=business@foxquart.com

# The From address on notification emails — must be on the Resend-verified domain.
CONTACT_FROM_EMAIL=Foxquart Website <noreply@foxquart.com>
